# Configuration file for build_apk.sh
# ==============================================================================

# Relative path to the module source code from ANDROID_TOP
SOURCE_CODE_RELATIVE_PATH="...@Todo"

# Relative path to the output directory from ANDROID_TOP where the APK is generated
APK_OUTPUT_RELATIVE_PATH="out/...@Todo"

# Name of the built APK file
APK_FILE_NAME="@Todo.apk"

# Android build target product (from: lunch abc_xyz_in-userdebug)
CONFIG_TARGET_PRODUCT="abc_xyz_in"

# Android build variant (from: lunch qssi_xyz_in-userdebug)
CONFIG_TARGET_BUILD_VARIANT="xyzdebug"

# Set to "true" to deploy the APK to the device and capture logcat after building ("true" - "false")
ENABLE_DEPLOY="true"

# Absolute path on the device where the APK should be pushed during deployment
APK_DEPLOY_PATH="/system/priv-app/OemService"

# Set to "true" to capture logcat after deployment (only used when ENABLE_DEPLOY is "true")
ENABLE_LOGCAT="false"
 
# Test directory, relative to this script's directory (used by --test-mode true)
TEST_RELATIVE_PATH="tests"

# Test build script name inside TEST_RELATIVE_PATH (used by --test-mode true)
TEST_BUILD_SCRIPT="build_oemcarservice_test.sh"

