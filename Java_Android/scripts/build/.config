# Configuration file for build_apk.sh
# ==============================================================================

# Relative path to the module source code from ANDROID_TOP
SOURCE_CODE_RELATIVE_PATH="...@Todo"

# Relative path to the output directory from ANDROID_TOP where the APK is generated
APK_OUTPUT_RELATIVE_PATH="out/...@Todo"

# Name of the built APK file
APK_FILE_NAME="@Todo.apk"

# Android build target product (from: lunch abc_xyz_in-userdebug)
CONFIG_TARGET_PRODUCT="abc_xyz_in"

# Android build variant (from: lunch qssi_xyz_in-userdebug)
CONFIG_TARGET_BUILD_VARIANT="xyzdebug"
