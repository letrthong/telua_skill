{
  "project_name": "telua_skill Java_Android Workspace",
  "verification_steps": [
    {
      "id": "clean_whitespace",
      "name": "Clean Code Whitespace",
      "enabled": true,
      "command": "python Java_Android/scripts/clean_java.py",
      "description": "Strip trailing whitespace from all .java source files"
    },
    {
      "id": "unit_tests",
      "name": "Run JUnit & Mockito Unit Tests",
      "enabled": true,
      "command": "./gradlew testDebugUnitTest",
      "description": "Execute automated unit test suites"
    },
    {
      "id": "lint_check",
      "name": "Android Lint & Static Analysis",
      "enabled": true,
      "command": "./gradlew lintDebug",
      "description": "Verify zero static analysis errors"
    },
    {
      "id": "build_apk",
      "name": "Build APK Binary",
      "enabled": false,
      "command": "./Java_Android/scripts/build_apk.sh",
      "description": "Compile and package application APK binary"
    }
  ]
}
